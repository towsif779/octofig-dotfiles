{
    "layer": "top",
    "position": "top",
    "height": -10,
    "spacing":5,

    "modules-left": ["hyprland/workspaces",  "custom/platform-profile",  "temperature",  "custom/cava"],
    "modules-center": ["clock"],
    "modules-right": [ "custom/cpucat", "hyprland/window",  "wireplumber",  "battery", "backlight", "custom/notification",  "custom/wallpaper", "custom/power",   "tray" ],

    "hyprland/workspaces": {
        "format": "<span size='larger'>{icon}</span>",
        "on-click": "activate",
        "format-icons": {
            "active": "\uf444",
            "default": "\uf4c3"
        },
        "icon-size": 10,
        "sort-by-number": true,
        "persistent-workspaces": {
            "1": [],
            "2": [],
            "3": [],
            "4": [],
            "5": [],
        }
    },

    "clock": {
        "format": "{:%d.%m.%Y | %H:%M}",
        "tooltip-format": "exec-once  = ~/.local/bin/media-popup"
       
    },

    "wireplumber": {
        "format": "\udb81\udd7e  {volume}%",
        "max-volume": 100,
 "scroll-step": 1,
    "on-scroll-up": "swayosd-client --output-volume +1",
    "on-scroll-down": "swayosd-client --output-volume -1"

    },

    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "format": "{icon}  {capacity}%",
        "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    },

    "memory": {
        "interval": 30,
        "format": "\uf4bc  {used:0.1f}G"
    },

    "temperature": {
        "format": "{temperatureC}°C"
    },

    "network": {
        "format": "",
        "format-ethernet": "\udb83\udc9d",
        "format-wifi": "{icon}",
        "format-disconnected": "\udb83\udc9c",
        "format-icons": ["\udb82\udd2f", "\udb82\udd1f", "\udb82\udd22", "\udb82\udd25", "\udb82\udd28"],
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-ethernet": "{ifname}",
        "tooltip-format-disconnected": "Disconnected",
    },

    "bluetooth": {
     "format": "{icon}",
    "format-icons": ["󰂯", "󰤾", "󰥀", "󰥄", "󰥈"],

        "on-click": " kitty --class bluetui-popup bluetui",
 "format-connected": "{icon} {num_connections}",
    "format-connected-battery": "{icon} {device_battery_percentage}%",

    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_battery_percentage}%",
    },

"hyprland/window": {
"max-length": 0, // Characters count
  "separate-outputs": true,
   "icon-size": 14,
  "icon": true
},


"custom/cpucat": {
  "exec": "~/waycat/catloop.sh",
  "interval": 0,
  "return-type": "text",
  "tooltip": false
},

"custom/skull": {
  "exec": "~/scripts/skull.sh",
  "interval": 0,
  "return-type": "text",
  "tooltip": false
},


 "custom/wallpaper": {
     "format": " ",
     "on-click": "waypaper --random",
     "on-click-right": "waypaper",
     "tooltip": false,
    "on-hover": " ~/.local/bin/media-popup",
   },

 "custom/power": {
    "format": "{icon}",
    "format-icons": " ", //  
    "exec-on-event": "true",
    "on-click": "wlogout",
    "tooltip-format": "Power Menu",
  },

  "custom/cava": {
    "exec": "~/.config/waybar/scripts/cava.sh",
    "on-click-middle": "playerctl play-pause",
    "on-click-right": "playerctl next",
    "on-click-left": "playerctl previous"
  },


 "custom/notification": {
    "tooltip": false,
    "format": "󰂚 ",
    "format-icons": {
      "notification": "󰂚<span foreground='red'><sup></sup></span>",
      "none": "",
      "dnd-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-none": "",
      "inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "inhibited-none": "",
      "dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
      "dnd-inhibited-none": "",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },

 "backlight": {
    "format": "  {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-click": "alacritty --class float -e nvim ~/.config/hypr/settings/monitors.conf",
    "scroll-step": 5,
    "tooltip": false
  },

    "hyprland/language": {
        "format": "{short}"
    },

    "tray": {
        "icon-size": 10,
        "spacing": 10
    },

    "custom/platform-profile": {
	"format": "{icon} ",
	"exec": "~/.config/waybar/platform_profile.sh",
	"return-type": "json",
	"restart-interval": 1,
	"format-icons": {
	    "quiet": "\udb80\udf2a",
	    "balanced": "\udb80\ude10",
	    "performance": "\uf427",
            "default": "?"
	},
    },

    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "\udb80\udd76",
            "deactivated": "\udb83\udfaa"
        }
    }
}
